{
  "rules": {
    "presence": {
      "$employeeId": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['status', 'lastSeen'])"
      }
    },
    "attendance_realtime": {
      "$logId": {
        ".read": true,
        ".write": true
      }
    },
    "notifications": {
      "$notifId": {
        ".read": true,
        ".write": true
      }
    },
    "shifts_status": {
      ".read": true,
      ".write": true
    },
    "settings": {
      ".read": true,
      ".write": true
    },
    ".read": false,
    ".write": false
  }
}
